<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.ui.controller.CoachesController"
      spacing="20" styleClass="coaches-view">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="searchField" promptText="🔍 بحث بالاسم أو التخصص..."
                   styleClass="search-field text-field" prefWidth="350"/>

        <ComboBox fx:id="filterStatus" promptText="الحالة" prefWidth="150" styleClass="combo-box"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblTotalCoaches" text="إجمالي المدربين: 0" styleClass="total-label"/>

        <Button text="➕ إضافة مدرب" styleClass="primary-button" onAction="#showAddCoachDialog"/>
    </HBox>

    <!-- Table Container -->
    <TableView fx:id="coachesTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="#" minWidth="50" maxWidth="60"/>
            <TableColumn fx:id="colName" text="اسم المدرب" minWidth="150"/>
            <TableColumn fx:id="colSpecialty" text="التخصص" minWidth="150"/>
            <TableColumn fx:id="colSalary" text="الراتب" minWidth="120"/>
            <TableColumn fx:id="colMembers" text="عدد المتدربين" minWidth="130"/>
            <TableColumn fx:id="colStatus" text="الحالة" minWidth="90"/>
            <TableColumn fx:id="colNotes" text="ملاحظات" minWidth="150"/>
            <TableColumn fx:id="colActions" text="الإجراءات" minWidth="80" maxWidth="100"/>
        </columns>

        <placeholder>
            <Label text="لا يوجد مدربين" styleClass="placeholder-label"/>
        </placeholder>
    </TableView>
</VBox>