<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.ui.controller.ProductsController"
      spacing="20" styleClass="products-view">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="searchField" promptText="🔍 بحث عن منتج..."
                   styleClass="search-field text-field" prefWidth="250"/>

        <ComboBox fx:id="filterCategory" promptText="الكل" prefWidth="150" styleClass="combo-box"/>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label text="قيمة المخزون" styleClass="stat-mini-label"/>
            <Label fx:id="lblTotalValue" text="0 ج.م" styleClass="stat-mini-value"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label text="الإيرادات المتوقعة" styleClass="stat-mini-label"/>
            <Label fx:id="lblPotentialRevenue" text="0 ج.م" styleClass="stat-mini-value text-success"/>
        </VBox>

        <Button text="➕ إضافة منتج" styleClass="primary-button" onAction="#showAddProductDialog"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Products Table -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="#" minWidth="50" maxWidth="60"/>
                    <TableColumn fx:id="colName" text="المنتج" minWidth="150"/>
                    <TableColumn fx:id="colCategory" text="التصنيف" minWidth="100"/>
                    <TableColumn fx:id="colQuantity" text="الكمية" minWidth="70"/>
                    <TableColumn fx:id="colPurchasePrice" text="سعر الشراء" minWidth="100"/>
                    <TableColumn fx:id="colSalePrice" text="سعر البيع" minWidth="100"/>
                    <TableColumn fx:id="colProfit" text="الربح/وحدة" minWidth="100"/>
                    <TableColumn fx:id="colActions" text="الإجراءات" minWidth="80" maxWidth="100"/>
                </columns>

                <placeholder>
                    <Label text="لا توجد منتجات" styleClass="placeholder-label"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Low Stock Alerts Panel -->
        <VBox styleClass="card" minWidth="280" maxWidth="320" spacing="10">
            <Label text="⚠️ تنبيهات المخزون" styleClass="card-title"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="lowStockAlerts" spacing="10"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
