<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.ui.controller.CheckInController"
      spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <!-- Search Section - نفس ستايل البقية -->
    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="🔍 البحث عن المشترك" style="-fx-font-size: 16; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="أدخل معرف المشترك (ID)" prefWidth="350"
                       style="-fx-font-size: 13; -fx-padding: 12; -fx-border-radius: 5; -fx-border-color: #ddd;"/>
            <Button fx:id="btnSearch" text="🔎 بحث"
                    style="-fx-font-size: 13; -fx-padding: 12 30; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-radius: 5;"/>
        </HBox>
    </VBox>

    <Separator style="-fx-border-color: #e0e0e0;"/>

    <!-- Member Info Section -->
    <VBox fx:id="memberInfoBox" spacing="20"
          style="-fx-padding: 20; -fx-background-color: white; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

        <Label text="📋 معلومات المشترك"
               style="-fx-font-size: 16; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;"/>

        <!-- Row 1: Basic Info -->
        <HBox spacing="20">
            <VBox spacing="8" style="-fx-min-width: 150;">
                <Label text="معرف العضوية:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblMemberId" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </VBox>
            <VBox spacing="8" style="-fx-min-width: 200;">
                <Label text="الاسم:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblMemberName" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>
            <VBox spacing="8" style="-fx-min-width: 180;">
                <Label text="رقم الهاتف:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblPhone" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>
        </HBox>

        <!-- Row 2: Gender, Coach, Plan -->
        <HBox spacing="20">
            <VBox spacing="8" style="-fx-min-width: 150;">
                <Label text="الجنس:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblGender" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>
            <VBox spacing="8" style="-fx-min-width: 200;">
                <Label text="المدرب:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblCoach" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>
            <VBox spacing="8" style="-fx-min-width: 150;">
                <Label text="الخطة:" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: bold;"/>
                <Label fx:id="lblPlan" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
            </VBox>
        </HBox>

        <Separator style="-fx-border-color: #e0e0e0;"/>

        <!-- Row 3: Status and Expiry -->
        <Label text="📊 حالة الاشتراك والحصص"
               style="-fx-font-size: 14; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;"/>

        <HBox spacing="20">
            <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-border-radius: 5; -fx-min-width: 180;">
                <Label text="حالة الاشتراك:" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <Label fx:id="lblStatus" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-border-radius: 5; -fx-min-width: 180;">
                <Label text="تاريخ الانتهاء:" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <Label fx:id="lblSubscriptionEnd" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </VBox>
        </HBox>

        <!-- Sessions Info -->
        <Separator style="-fx-border-color: #e0e0e0;"/>
        <Label text="🎯 معلومات الحصص"
               style="-fx-font-size: 14; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;"/>

        <HBox spacing="20">
            <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #f0fdf4; -fx-border-radius: 5; -fx-border-color: #22c55e; -fx-border-width: 2; -fx-min-width: 180;">
                <Label text="الحصص المتبقية:" style="-fx-font-size: 12; -fx-text-fill: #15803d;"/>
                <Label fx:id="lblRemainingSession" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
            </VBox>
            <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #eff6ff; -fx-border-radius: 5; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-min-width: 180;">
                <Label text="إجمالي الحصص:" style="-fx-font-size: 12; -fx-text-fill: #1e40af;"/>
                <Label fx:id="lblTotalSession" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </VBox>
            <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #fffbeb; -fx-border-radius: 5; -fx-border-color: #f59e0b; -fx-border-width: 2; -fx-min-width: 180;">
                <Label text="حالة الحصص:" style="-fx-font-size: 12; -fx-text-fill: #92400e;"/>
                <Label fx:id="lblSessionsStatus" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Actions Section - في النص -->
    <VBox fx:id="actionsBox" spacing="15" alignment="CENTER"
          style="-fx-padding: 20; -fx-background-color: white; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="⚙️ الإجراءات المتاحة"
               style="-fx-font-size: 14; -fx-text-fill: #1a1a1a; -fx-font-weight: bold;"/>

        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="btnRecordAttendance" text="✓ تسجيل حضور" prefWidth="200"
                    style="-fx-font-size: 13; -fx-padding: 14; -fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"/>
            <Button fx:id="btnRenewSubscription" text="🔄 تجديد الاشتراك" prefWidth="200"
                    style="-fx-font-size: 13; -fx-padding: 14; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"/>
            <Button fx:id="btnDeleteMember" text="✕ حذف المشترك" prefWidth="200"
                    style="-fx-font-size: 13; -fx-padding: 14; -fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>
</VBox>