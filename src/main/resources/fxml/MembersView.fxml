<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.ui.controller.MembersController"
      spacing="20"
      styleClass="members-view">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="searchField"
                   promptText="🔍 بحث بالاسم أو الهاتف أو رقم العضوية..."
                   styleClass="search-field text-field"
                   prefWidth="350"/>

        <ComboBox fx:id="filterStatus"
                  promptText="الحالة"
                  prefWidth="150"
                  styleClass="combo-box"/>

        <ComboBox fx:id="filterGender"
                  promptText="الجنس"
                  prefWidth="150"
                  styleClass="combo-box"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblTotalMembers"
               text="إجمالي المشتركين: 0"
               styleClass="total-label"/>

        <Button text="➕ إضافة مشترك"
                styleClass="primary-button"
                onAction="#showAddMemberDialog"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="membersTable"
               VBox.vgrow="ALWAYS"
               styleClass="data-table">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="colId" text="#" minWidth="50" maxWidth="60"/>
            <TableColumn fx:id="colMemberId" text="رقم العضوية" minWidth="100"/>
            <TableColumn fx:id="colName" text="الاسم" minWidth="130"/>
            <TableColumn fx:id="colGender" text="الجنس" minWidth="100"/>
            <TableColumn fx:id="colPhone" text="رقم الهاتف" minWidth="110"/>
            <TableColumn fx:id="colCoach" text="الكوتش" minWidth="120"/>
            <TableColumn fx:id="colPlan" text="نوع الاشتراك" minWidth="120"/>
            <TableColumn fx:id="colEndDate" text="تاريخ الانتهاء" minWidth="100"/>
            <TableColumn fx:id="colStatus" text="الحالة" minWidth="90"/>
            <TableColumn fx:id="colActions" text="الإجراءات" minWidth="80" maxWidth="100"/>
        </columns>

        <placeholder>
            <Label text="لا يوجد مشتركين"
                   styleClass="placeholder-label"/>
        </placeholder>
    </TableView>

</VBox>